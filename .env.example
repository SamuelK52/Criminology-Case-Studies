# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Supabase → Project Settings → API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…) or the legacy anon key. Safe in the browser — RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Only used by `npm run db:setup` on your machine. Supabase → Connect → Session pooler.
# Do NOT add this to Vercel.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Anthropic — server only (used from Milestone 3). Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5-5
