# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# PostgreSQL owner/admin connection. Used ONLY by `npm run db:setup` (migrations + seed).
#   Railway service variable: DATABASE_URL=${{Postgres.DATABASE_URL}}
#   Local dev against Railway: use the Postgres service's DATABASE_PUBLIC_URL instead.
DATABASE_URL=postgresql://postgres:OWNER-PASSWORD@host:5432/railway

# Password for the `caselab_app` role that the web app logs in as at runtime.
# Not a superuser, so Row Level Security applies. Any random string of 16+ characters,
# e.g. generate one with: node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
APP_DB_PASSWORD=change-me-to-a-long-random-string

# Optional: a full connection string for the app role (overrides the two above at runtime).
# APP_DATABASE_URL=postgresql://caselab_app:PASSWORD@host:5432/railway

# Optional: connection pool size (default 10). Use 1 with a local PGlite server, which shares one session.
# DB_POOL_MAX=10

# AI — server only. Never prefix with NEXT_PUBLIC_. Set ONE of these; Gemini wins if both are set.
# Google Gemini (free tier available): key from aistudio.google.com → Get API key.
GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-3.5-flash-lite
# Anthropic Claude: key from console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-sonnet-5-5
